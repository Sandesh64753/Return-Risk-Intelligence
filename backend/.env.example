# Product Return Risk Intelligence Platform Configuration
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security secret key for session cookies (change for production)
SECRET_KEY=dev-secure-session-signing-key-change-for-production-min32bytes

# Database Configuration (Neon PostgreSQL or SQLite)
# Neon connection string:
POSTGRESS_DATABASE=postgresql://neondb_owner:password@ep-morning-dew-b500nhyb-pooler.c-7.us-east-2.aws.neon.tech/Data%20Storage%20of%20product%20details?sslmode=require&channel_binding=require
# Alternative standard variable:
# DATABASE_URL=postgresql://neondb_owner:password@ep-morning-dew-b500nhyb-pooler.c-7.us-east-2.aws.neon.tech/Data%20Storage%20of%20product%20details?sslmode=require&channel_binding=require

# Database pool tuning (optional)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Path to serialized model bundle (relative or absolute)
ARTIFACT_PATH=artifacts/model.joblib

# Optional override for the operational decision threshold (defaults to ~0.3974 from model bundle)
# PREDICTION_THRESHOLD=0.397378359285296
